extends "res://run_archer_volley_test.gd"

func _run() -> void:
	arena = load("res://scenes/EmptyArena.tscn").instantiate() as Node3D
	root.add_child(arena)
	var bow: ArcherCombat = await fresh_volley()
	check(player.ability_system.get_ability("skill_2").id == "archer_seeking_arrows" and player.ability_system.get_ability("skill_3").id == "archer_forest_escape", "Archer X/C isolated abilities equipped")
	player.stamina_component.current_stamina = 29
	check(not bow.start_seeking() and not player.ability_system.is_on_cooldown("skill_2"), "X insufficient energy spends nothing")
	player.stamina_component.current_stamina = 100
	enemy.position.x = 15
	await frames(2)
	check(not bow.start_seeking() and player.stamina_component.current_stamina == 100, "X needs visible target inside aim cone")
	enemy.position.x = 0
	await frames(2)
	action("skill_2", true)
	action("skill_2", false)
	await frames(1)
	check(bow.seeking_active and player.stamina_component.current_stamina == 70, "Real X input starts and pays once")
	check(not bow.start_charge() and not bow.start_hawk() and not bow.start_seeking(), "X cannot overlap other attacks")
	await frames(10)
	check(bow.shots_fired == 0 and enemy.health_component.current_health == 500, "X startup has no instant damage")
	await frames(90)
	check(bow.seeking_shots == 3 and bow.shots_fired == 3, "X emits exactly three arrows")
	check(is_equal_approx(enemy.health_component.current_health, 458), "Three X arrows deal 42 once")
	check(player.stamina_component.current_stamina == 70 and not bow.start_seeking(), "No energy farm or cooldown bypass")
	bow = await fresh_volley()
	bow.start_seeking()
	await frames(20)
	enemy.position.x = 2
	await frames(90)
	check(enemy.health_component.current_health < 500, "Seeking arrows follow a moving target")
	bow = await fresh_volley()
	enemy.visuals.rotation.y = PI
	enemy._camera_yaw = PI
	enemy._start_block()
	bow.start_seeking()
	await frames(100)
	check(is_equal_approx(enemy.health_component.current_health, 493.7) and is_equal_approx(enemy.shield_durability, 76), "Knight blocks X with 24 total durability loss")
	bow = await fresh_volley()
	bow.start_seeking()
	await frames(5)
	player.apply_hit_reaction(Vector3.BACK)
	await frames(90)
	check(bow.shots_fired == 0 and not bow.seeking_active and player.stamina_component.current_stamina == 70, "Hit cancels X startup without refund")
	bow = await fresh_volley()
	bow.start_seeking()
	await frames(25)
	enemy.health_component.take_damage(1000)
	await frames(80)
	check(not bow.seeking_active and bow._arrows.is_empty(), "Dead target stops emissions; launched arrows expire without reacquisition")
	bow = await fresh_volley()
	player.stamina_component.current_stamina = 24
	check(not bow.start_escape() and not player.ability_system.is_on_cooldown("skill_3"), "C insufficient energy spends nothing")
	player.stamina_component.current_stamina = 100
	var start: Vector3 = player.global_position
	action("skill_3", true)
	action("skill_3", false)
	await frames(1)
	check(bow.dash_active and bow.is_hidden() and not player.is_targetable() and player.stamina_component.current_stamina == 75, "Real C starts dash and stealth; pays once")
	check(not bow.start_escape() and not bow.start_charge() and not player._start_block(), "Dash prevents overlapping actions")
	check(not player.dodge_controller.is_invulnerable, "C grants no dodge invulnerability")
	await frames(45)
	check(absf(start.z - player.global_position.z - 5) < 0.02 and not bow.dash_active, "C travels five meters then unlocks movement")
	check(bow.is_hidden() and not bow._stealth_surfaces.is_empty() and is_equal_approx(bow._stealth_surfaces[0].faded.albedo_color.a, 0.22) and bow._stealth_surfaces[0].mesh.get_surface_override_material(bow._stealth_surfaces[0].index) == bow._stealth_surfaces[0].faded, "Local silhouette remains transparent after dash")
	check(bow.start_charge() and bow.is_hidden() and not player.is_targetable(), "Charging a basic attack preserves stealth")
	bow.cancel_charge()
	bow = await fresh_volley()
	bow.start_escape()
	await frames(30)
	player.take_damage(25)
	check(bow.is_hidden() and player.health_component.current_health < 200, "Real damage preserves stealth without granting invulnerability")
	bow = await fresh_volley()
	bow.start_escape()
	await frames(650)
	check(not bow.is_hidden() and player.is_targetable() and bow._stealth_meshes[0].transparency == 0, "Stealth expires and restores visuals")
	bow = await fresh_volley()
	var wall: StaticBody3D = StaticBody3D.new()
	wall.collision_layer = 1
	var shape: CollisionShape3D = CollisionShape3D.new()
	var box: BoxShape3D = BoxShape3D.new()
	box.size = Vector3(8, 4, 0.2)
	shape.shape = box
	wall.add_child(shape)
	arena.add_child(wall)
	wall.position = Vector3(0, 2, 0)
	await frames(2)
	check(not bow.start_seeking(), "X cannot lock through walls")
	bow.start_escape()
	await frames(35)
	check(player.global_position.z > 0.35 and player.global_position.z < 1, "C stops at wall without passing through")
	wall.queue_free()
	bow = await fresh_volley()
	bow.start_hawk()
	await frames(5)
	check(bow.start_escape() and not bow.hawk_skill.casting, "C cancels volley for escape")
	await frames(35)
	check(bow.shots_fired == 0 and player.stamina_component.current_stamina == 50, "Canceled Z and C retain their own cost")
	bow = await fresh_volley()
	var brain: PracticeOpponent = PracticeOpponent.new()
	brain.actor = enemy
	brain.target = player
	brain.enabled = true
	arena.add_child(brain)
	bow.start_escape()
	await frames(35)
	check(enemy.external_move_direction == Vector3.ZERO and brain.attacks_started == 0 and brain.skill_warning_remaining == 0, "AI stops tracking and starting attacks during stealth")
	bow.end_stealth()
	await frames(5)
	check(enemy.external_move_direction != Vector3.ZERO, "AI reacquires revealed target")
	brain.queue_free()
	bow = await fresh_volley()
	bow.start_escape()
	player.controls_enabled = false
	await frames(5)
	check(not bow.is_hidden() and not bow.dash_active and bow._arrows.is_empty(), "Round lock restores stealth and cancels dash")
	bow = await fresh_volley()
	bow.start_escape()
	player.health_component.take_damage(1000)
	await frames(5)
	check(player.is_dead and not bow.is_hidden() and not bow.dash_active, "Death clears C and restores visual state")
	bow = await fresh_volley()
	bow.start_escape()
	await frames(45)
	check(not bow.start_escape() and player.ability_system.get_cooldown_remaining("skill_3") > 9.0, "C cooldown remains after dash ends")
	check(bow.start_hawk() and bow.is_hidden(), "Starting Z preserves stealth until its fish hits")
	bow = await fresh_volley()
	bow.start_escape()
	await frames(45)
	# Escape ended at z=-2, opponent stays in the visible forward cone.
	check(bow.start_seeking() and bow.is_hidden(), "Starting X preserves stealth until an arrow hits")
	bow = await fresh_volley()
	bow.start_seeking()
	await frames(20)
	var first: Dictionary = bow._arrows[0]
	var before_direction: Vector3 = first.direction
	enemy.position.x = 5
	await frames(1)
	check(before_direction.angle_to(first.direction) <= deg_to_rad(110.0) / 60.0 + 0.003, "X turn rate bounded at 110 degrees per second")
	bow.reset()
	bow = await fresh_volley()
	bow.start_seeking()
	await frames(20)
	wall = StaticBody3D.new()
	wall.collision_layer = 1
	shape = CollisionShape3D.new()
	shape.shape = box
	wall.add_child(shape)
	arena.add_child(wall)
	wall.position = Vector3(0, 2, -1)
	await frames(100)
	check(enemy.health_component.current_health == 500 and bow._arrows.is_empty(), "Wall appearing after lock stops seeking arrows")
	wall.queue_free()
	bow = await fresh_volley()
	bow.start_seeking()
	await frames(5)
	action("block", true)
	await frames(2)
	check(not bow.seeking_active and player.is_blocking and bow.shots_fired == 0, "RMB cancels X into real guard")
	action("block", false)
	bow = await fresh_volley()
	bow.start_seeking()
	await frames(20)
	enemy.queue_free()
	await frames(100)
	check(not bow.seeking_active and bow._arrows.is_empty(), "Deleted target clears tracking safely")
	bow = await fresh_volley()
	player.set_third_person(false)
	check(bow.start_seeking(), "X supports FPS")
	await frames(100)
	check(enemy.health_component.current_health == 458, "FPS X hits with same physical arrows")
	check(bow.start_escape(), "C supports FPS")
	bow.reset()
	arena.queue_free()
	await frames(3)
	CombatTimeManager.reset_time()
	print("RESULTS: %d/%d PASSED" % [passed, total])
	quit(0 if passed == total else 1)

