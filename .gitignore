# Godot 4 specific ignores
.godot/
*.translation

# Godot-specific export / temporary files
*.tmp

# Blender backup and autosave files
*.blend1
*.blend2
*.blend3
*.blend@
*.blend@@
*.blend@@@

# OS specific files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Logs & crash dumps
*.log
*.dmp

# Test generated screenshots
phase*.png
phase*.png.import
runtime_screenshot.png
runtime_screenshot.png.import

# Blender autosave files
*autosave.blend
*autosave.blend.import

# Environment / Secret tokens (if any)
.env
.env.*
*.secret


# Local editor binary, caches, model experiments and source backups.
/Godot.exe
__pycache__/
*.pyc
*.bak
*.backup
*.backup2
/assets/models/*_backup.glb
/assets/models/*_backup.glb.import
/assets/models/m_archer_preview/

# Scratch experiments stay local; tracked fixtures remain tracked.
/scratch/*
!/scratch/hawk_phase_3.png
!/scratch/hawk_phase_3.png.import
!/scratch/hawk_gameplay_tps.png
!/scratch/hawk_gameplay_tps.png.import
!/scratch/hawk_victim_fps.png
!/scratch/hawk_victim_fps.png.import
!/scratch/test_fp_and_sidedash.gd
