# Godot 4 specific ignores
.godot/
*.translation

# Godot-specific export / temporary files
*.tmp

# Blender backup and autosave files
*.blend1
*.blend2
*.blend3
*.blend@
*.blend@@
*.blend@@@

# OS specific files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Logs & crash dumps
*.log
*.dmp

# Test generated screenshots
phase*.png
phase*.png.import
runtime_screenshot.png
runtime_screenshot.png.import

# Blender autosave files
*autosave.blend
*autosave.blend.import

# Environment / Secret tokens (if any)
.env
.env.*
*.secret

# Generated test PNGs; keep the three current hawk documentation previews.
/scratch/*.png
/scratch/*.png.import
!/scratch/hawk_phase_3.png
!/scratch/hawk_phase_3.png.import
!/scratch/hawk_gameplay_tps.png
!/scratch/hawk_gameplay_tps.png.import
!/scratch/hawk_victim_fps.png
!/scratch/hawk_victim_fps.png.import
