extends "res://run_archer_basic_test.gd"

func fresh_volley() -> ArcherCombat:
	await fresh()
	enemy.hit_knockback_distance = 0.0
	enemy.block_recoil_distance = 0.0
	player.stamina_component.current_stamina = 100.0
	return player.archer_combat

func _run() -> void:
	root.size = Vector2i(1152, 720)
	arena = load("res://scenes/EmptyArena.tscn").instantiate() as Node3D
	root.add_child(arena)
	var bow: ArcherCombat = await fresh_volley()
	player.stamina_component.current_stamina = 24.0
	check(not player._try_cast_ability("skill_1") and not bow.volley_active, "Insufficient energy rejects Z")
	check(is_equal_approx(player.stamina_component.current_stamina, 24.0) and not player.ability_system.is_on_cooldown("skill_1"), "Rejected cast spends nothing and starts no cooldown")
	player.stamina_component.current_stamina = 100
	action("skill_1", true)
	action("skill_1", false)
	await frames(1)
	check(bow.volley_active and is_equal_approx(player.stamina_component.current_stamina, 75), "Real Z input starts volley and consumes 25 energy once")
	check(player.ability_system.is_on_cooldown("skill_1"), "Z starts 5-second cooldown")
	check(not bow.start_charge() and not bow.start_volley(), "Volley prevents overlapping LMB or Z casts")
	await frames(8)
	check(bow.volley_shots_fired == 0 and is_equal_approx(enemy.health_component.current_health, 500), "Startup telegraphs without early arrows or damage")
	await frames(12)
	check(bow.volley_shots_fired > 0 and bow.volley_shots_fired < 6, "Arrows emit sequentially instead of instant burst")
	await frames(80)
	check(bow.volley_shots_fired == 6 and bow.shots_fired == 6 and not bow.volley_active, "Volley ends after exactly six arrows")
	check(is_equal_approx(enemy.health_component.current_health, 458), "Six physical hits deal 42 total damage")
	check(is_equal_approx(player.stamina_component.current_stamina, 75), "Skill hits do not refill their own energy cost")
	check(not bow.start_volley(), "Cooldown prevents immediate repeat")
	check(bow.start_charge(), "Basic shot resumes after volley recovery")
	bow.cancel_charge()
	await frames(230)
	check(bow.start_volley(), "Z unlocks naturally when cooldown expires")
	bow.reset()
	bow = await fresh_volley()
	enemy.visuals.rotation.y = PI
	enemy._camera_yaw = PI
	enemy._start_block()
	bow.start_volley()
	await frames(100)
	check(is_equal_approx(enemy.health_component.current_health, 493.7), "Knight blocks each arrow with one 85-percent reduction")
	check(is_equal_approx(enemy.shield_durability, 70), "Volley does 5 shield damage per arrow, 30 total")
	bow = await fresh_volley()
	var wall: StaticBody3D = StaticBody3D.new()
	wall.collision_layer = 1
	var collision: CollisionShape3D = CollisionShape3D.new()
	var box: BoxShape3D = BoxShape3D.new()
	box.size = Vector3(6, 4, 0.2)
	collision.shape = box
	wall.add_child(collision)
	arena.add_child(wall)
	wall.position = Vector3(0, 2, 0)
	await frames(3)
	bow.start_volley()
	await frames(100)
	check(is_equal_approx(enemy.health_component.current_health, 500) and bow._arrows.is_empty(), "World wall blocks entire volley")
	wall.queue_free()
	bow = await fresh_volley()
	bow.start_volley()
	enemy.position.x = 4.0
	await frames(100)
	check(is_equal_approx(enemy.health_component.current_health, 500), "Enemy can leave committed aim before shots; volley does not track")
	bow = await fresh_volley()
	bow.start_volley()
	player._camera_yaw = PI
	await frames(35)
	check(absf(bow._volley_yaw - bow._volley_start_yaw) <= deg_to_rad(12.01), "Mouse steering limited to 12 degrees from initial aim")
	bow = await fresh_volley()
	bow.start_volley()
	await frames(5)
	player.apply_hit_reaction(Vector3.BACK)
	await frames(80)
	check(not bow.volley_active and bow.shots_fired == 0, "Hit during startup cancels all remaining shots")
	check(is_equal_approx(player.stamina_component.current_stamina, 75) and player.ability_system.is_on_cooldown("skill_1"), "Interrupt retains spent energy and cooldown")
	bow = await fresh_volley()
	bow.start_volley()
	await frames(25)
	var emitted: int = bow.shots_fired
	player.apply_hit_reaction(Vector3.BACK)
	await frames(80)
	check(emitted > 0 and emitted < 6 and bow.shots_fired == emitted, "Mid-volley hit stops future emissions")
	bow = await fresh_volley()
	bow.start_volley()
	await frames(5)
	check(player._try_dodge() and not bow.volley_active, "Q cancels volley and starts normal dodge")
	await frames(70)
	check(bow.shots_fired == 0, "Canceled volley cannot resume after dodge")
	bow = await fresh_volley()
	bow.start_volley()
	action("block", true)
	action("block", false)
	await frames(80)
	check(not bow.volley_active and bow.shots_fired == 0 and not player.is_blocking, "RMB cancels volley without invisible shield")
	bow = await fresh_volley()
	bow.start_volley()
	player._set_mouse_captured(false)
	await frames(80)
	check(not bow.volley_active and bow.shots_fired == 0, "Esc cancels volley before firing")
	bow = await fresh_volley()
	bow.start_volley()
	await frames(23)
	player.controls_enabled = false
	await frames(80)
	check(not bow.volley_active and bow._arrows.is_empty() and is_equal_approx(enemy.health_component.current_health, 500), "Round lock clears volley and in-flight arrows")
	bow = await fresh_volley()
	bow.start_volley()
	player.health_component.take_damage(1000)
	await frames(70)
	check(player.is_dead and not bow.volley_active and bow.shots_fired == 0, "Death cancels volley")
	bow = await fresh_volley()
	player.set_third_person(false)
	bow.start_volley()
	await frames(100)
	check(is_equal_approx(enemy.health_component.current_health, 458), "FPS volley uses the same physical hits")
	bow = await fresh_volley()
	bow.start_charge()
	check(not bow.start_volley() and is_equal_approx(player.stamina_component.current_stamina, 100), "Z cannot bypass an ongoing charged shot")
	bow.cancel_charge()
	player.controls_enabled = false
	check(not bow.start_volley(), "Countdown rejects Z")
	player.controls_enabled = true
	player.stamina_component.training_infinite = true
	player.ability_system.ability_cast_started.connect(func(_slot: String, _data: AbilityData) -> void: player.ability_system.reset_cooldowns())
	check(bow.start_volley() and is_equal_approx(player.stamina_component.current_stamina, 100), "Infinite-energy arena flag works with Z")
	await frames(100)
	check(bow.start_volley(), "Arena no-cooldown flag allows next volley after recovery")
	arena.queue_free()
	await frames(3)
	print("RESULTS: %d/%d PASSED" % [passed, total])
	quit(0 if passed == total else 1)
