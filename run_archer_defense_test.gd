extends "res://run_archer_volley_test.gd"

func perfect() -> void:
	player.dodge_controller.dodge_distance = 0.0
	player._try_dodge()
	await frames(5)
	var payload: AttackPayload = AttackPayload.new(25, enemy.global_position)
	payload.attacker = enemy
	player.take_damage(payload)
	check(player.is_counter_window_active() and player.dodge_controller.perfect_dodge_count == 1, "Real dodge i-frame opens Counter window")

func _run() -> void:
	root.size = Vector2i(1152, 720)
	arena = load("res://scenes/EmptyArena.tscn").instantiate() as Node3D
	root.add_child(arena)
	var bow: ArcherCombat = await fresh_volley()
	action("block", true)
	await frames(2)
	check(player.is_blocking and is_equal_approx(bow._bow.rotation.z, PI * 0.5), "RMB raises bow horizontally")
	player.take_damage(25, enemy.global_position)
	check(is_equal_approx(player.health_component.current_health, 91.25), "Front bow block reduces 25 damage by 65 percent once")
	check(is_equal_approx(player.shield_durability, 85), "Block consumes durability once")
	action("block", false)
	await frames(12)
	check(not player.is_blocking, "RMB release lowers guard")
	bow = await fresh_volley()
	player._start_block()
	player.take_damage(25, player.global_position + Vector3.BACK * 3)
	check(is_equal_approx(player.health_component.current_health, 75) and is_equal_approx(player.shield_durability, 100), "Rear hit bypasses bow guard")
	bow = await fresh_volley()
	bow.start_charge()
	await frames(10)
	action("block", true)
	action("attack", false)
	check(player.is_blocking and not bow.charging and bow.shots_fired == 0, "RMB cancels charged arrow and enters guard without release shot")
	action("block", false)
	bow = await fresh_volley()
	bow.start_volley()
	await frames(5)
	action("block", true)
	check(player.is_blocking and not bow.volley_active, "RMB interrupts Z then guards")
	check(is_equal_approx(player.stamina_component.current_stamina, 75), "Canceling Z to guard does not refund energy")
	action("block", false)
	bow = await fresh_volley()
	player._start_block()
	player.take_damage(10, enemy.global_position, 100)
	check(player.is_shield_broken and not player.is_blocking, "Zero durability knocks bow out of guard")
	check(not bow.start_block() and not bow.start_charge() and not bow.start_volley(), "Broken bow rejects guard, basic shot and Z")
	await frames(135)
	check(not player.is_shield_broken and bow.start_block(), "Test-arena recovery restores bow guard")
	player._release_block()
	bow = await fresh_volley()
	check(not bow.start_counter() and bow.counters_fired == 0, "Counter cannot be cast without Perfect Dodge")
	player.stamina_component.current_stamina = 0.0
	await perfect()
	var start: Vector3 = player.global_position
	action("attack", true)
	action("attack", false)
	await frames(1)
	check(bow.counter_active and player.is_countering and bow.counters_fired == 1, "Fresh LMB shoots Counter without charging")
	check(not player.is_counter_window_active() and not player.dodge_controller.is_dodging, "Counter consumes window and ends dodge i-frames")
	check(bow._arrows.size() == 1 and (bow._arrows[0].node as Node3D).scale.x > 2.5, "Counter spawns visibly enlarged physical arrow")
	check(is_equal_approx(enemy.health_component.current_health, 500), "Counter is not instant hitscan damage")
	check(not bow.start_counter() and not bow.start_charge() and not bow.start_volley() and not bow.start_block(), "Counter prevents action overlap")
	await frames(55)
	check(is_equal_approx(enemy.health_component.current_health, 450), "Counter arrow deals 50 damage once")
	check(absf(player.global_position.z - start.z - 3.2) < 0.01, "Counter retreats 3.2 meters away from attacker")
	check(not bow.counter_active and not player.is_countering, "Retreat finishes in neutral state")
	check(is_equal_approx(player.stamina_component.current_stamina, 25), "Counter hits do not farm basic energy")
	bow = await fresh_volley()
	enemy.visuals.rotation.y = PI
	enemy._camera_yaw = PI
	enemy._start_block()
	await perfect()
	bow.start_counter()
	await frames(55)
	check(is_equal_approx(enemy.health_component.current_health, 492.5) and is_equal_approx(enemy.shield_durability, 80), "Knight blocks Counter once and loses 20 durability")
	bow = await fresh_volley()
	await perfect()
	var wall: StaticBody3D = StaticBody3D.new()
	wall.collision_layer = 1
	var shape: CollisionShape3D = CollisionShape3D.new()
	var box: BoxShape3D = BoxShape3D.new()
	box.size = Vector3(6, 4, 0.2)
	shape.shape = box
	wall.add_child(shape)
	arena.add_child(wall)
	wall.position = Vector3(0, 2, 0)
	await frames(2)
	bow.start_counter()
	await frames(55)
	check(is_equal_approx(enemy.health_component.current_health, 500), "Counter arrow stops at world wall")
	wall.queue_free()
	bow = await fresh_volley()
	await perfect()
	wall = StaticBody3D.new()
	wall.collision_layer = 1
	shape = CollisionShape3D.new()
	shape.shape = box
	wall.add_child(shape)
	arena.add_child(wall)
	wall.position = Vector3(0, 2, 4.5)
	await frames(2)
	bow.start_counter()
	await frames(55)
	check(player.global_position.z < 4.15 and player.global_position.z > 3, "Retreat stops against rear wall without teleporting through")
	wall.queue_free()
	bow = await fresh_volley()
	await perfect()
	await frames(70)
	check(not bow.start_counter(), "Expired Perfect Dodge window cannot counter")
	bow = await fresh_volley()
	await perfect()
	bow.start_counter()
	player.controls_enabled = false
	await frames(50)
	check(not bow.counter_active and bow._arrows.is_empty() and is_equal_approx(enemy.health_component.current_health, 500), "Round end clears Counter movement and arrow")
	bow = await fresh_volley()
	await perfect()
	bow.start_counter()
	player.health_component.take_damage(1000)
	await frames(50)
	check(player.is_dead and not bow.counter_active and bow._arrows.is_empty(), "Death cancels Counter cleanly")
	bow = await fresh_volley()
	player.set_third_person(false)
	await perfect()
	bow.start_counter()
	await frames(55)
	check(is_equal_approx(enemy.health_component.current_health, 450), "FPS Counter uses same physical projectile")
	arena.queue_free()
	await frames(3)
	CombatTimeManager.reset_time()
	print("RESULTS: %d/%d PASSED" % [passed, total])
	quit(0 if passed == total else 1)
